# Copy this file to .env and fill in what you use. Never commit .env.

# --- AI command parsing (optional; without a key the regex parser is used) ---
# Provider is picked automatically from whichever key is set (Gemini first).
# Set AI_PROVIDER to force one: gemini | groq | ollama
AI_PROVIDER=

# Google Gemini (free tier) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq (free tier, very fast) - https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Ollama (local) - https://ollama.com
OLLAMA_MODEL=llama3.2

# OpenAI (optional: Whisper speech recognition / prompt enhancement)
OPENAI_API_KEY=your_openai_api_key_here

# --- OCR ---
# Full path to tesseract.exe if it is not in C:\Program Files\Tesseract-OCR
TESSERACT_CMD=

# --- Screen Agent Configuration ---
SCREENSHOT_INTERVAL=0.5
CONFIDENCE_THRESHOLD=0.8
MAX_RETRIES=3

# --- Voice Processing ---
# Speech-to-text: groq (Whisper, default when GROQ_API_KEY is set) or google
# Benchmark (tests/scenarios/stt_benchmark.py): Whisper 3% word errors vs Google 44%
STT_PROVIDER=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Seconds of silence that end a command (lower = snappier, too low cuts you off)
VOICE_PAUSE_SECONDS=1.2
# Read WhatsApp messages back and wait for "yes" before sending by voice
WHATSAPP_VOICE_CONFIRM=true

# --- JARVIS personality ---
# How JARVIS addresses you (the films use "sir")
JARVIS_ADDRESS=sir
# Voice: neural (British "Ryan", online, falls back to Windows voice offline) or sapi
TTS_ENGINE=neural
JARVIS_VOICE=en-GB-RyanNeural
JARVIS_VOICE_RATE=+8%
JARVIS_VOICE_PITCH=-2Hz
# Model that answers questions / small talk (Groq)
JARVIS_BRAIN_MODEL=openai/gpt-oss-20b
# Seconds JARVIS keeps listening for follow-ups without the wake word
JARVIS_FOLLOWUP_SECONDS=20
VOICE_TIMEOUT=5
VOICE_PHRASE_TIMEOUT=1

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/screen_agent.log
