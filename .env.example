# OpenAI API Key (for advanced NLP processing)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Recommended for FREE AI command parsing - 60 requests/min)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Alternative - FREE, very fast - 30 requests/min)
# Get from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Screen Agent Configuration
SCREENSHOT_INTERVAL=0.5
CONFIDENCE_THRESHOLD=0.8
MAX_RETRIES=3

# Voice Processing
VOICE_TIMEOUT=5
VOICE_PHRASE_TIMEOUT=1

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/screen_agent.log
